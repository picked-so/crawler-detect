{
  "name": "@picked-so/crawler-detect",
  "version": "0.1.0",
  "description": "Detect AI crawlers (GPTBot, ChatGPT-User, ClaudeBot, PerplexityBot, Google-Agent and more) by user agent, and send their visits to Picked from Next.js, Express or any Fetch API server.",
  "keywords": ["ai crawlers", "gptbot", "chatgpt-user", "claudebot", "perplexitybot", "google-agent", "gemini", "ai bots", "user agent", "nextjs", "express", "cloudflare workers", "llm seo"],
  "homepage": "https://picked.so",
  "repository": { "type": "git", "url": "git+https://github.com/picked-so/crawler-detect.git" },
  "bugs": "https://github.com/picked-so/crawler-detect/issues",
  "license": "MIT",
  "author": "Picked <contact@picked.so> (https://picked.so)",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./next": { "types": "./dist/next.d.ts", "default": "./dist/next.js" },
    "./express": { "types": "./dist/express.d.ts", "default": "./dist/express.js" },
    "./fetch": { "types": "./dist/fetch.d.ts", "default": "./dist/fetch.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/crawler-detect.test.mjs",
    "prepublishOnly": "npm test"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
